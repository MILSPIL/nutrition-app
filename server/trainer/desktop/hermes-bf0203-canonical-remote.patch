+// @vitest-environment node
+import { expect, test } from 'vitest'
+import { canonicalGatewayWsUrl, canonicalRemoteWsUrl, freshRemoteCanonicalWsUrl } from '@hermes/shared'
+import { resolveTestWsUrl } from '../../electron/connection-config'
+import { createRegistryGatewayWsUrlHandler, createRemoteWsHeaderStore } from '../../electron/remote-ws-headers'
+const status = { scisense: { bridge_version: 1, protocol: 'hermes-gateway-v1', engine_commit: '3f2afed3eb813cb00bd381d29b084d0e01de048f' } }
+test('only authenticated negotiated remote chooses the canonical adapter', () => {
+  const legacy = 'ws://localhost:9001/api/ws?token=fixture'
+  expect(canonicalGatewayWsUrl(canonicalRemoteWsUrl(legacy, {}))).toBe(false)
+  expect(canonicalGatewayWsUrl(canonicalRemoteWsUrl(legacy, status))).toBe(true)
+  expect(canonicalGatewayWsUrl('ws://localhost/api/ws?native_dial=n')).toBe(true)
+  expect(canonicalGatewayWsUrl(canonicalRemoteWsUrl(legacy + '&hermes_canonical=1', {}))).toBe(false)
+  expect(() => canonicalRemoteWsUrl('ws://localhost/api/ws', status)).toThrow()
+  expect(() => canonicalRemoteWsUrl(legacy, { scisense: { ...status.scisense, bridge_version: 2 } })).toThrow()
+})
+test('ticket refresh keeps the negotiated protocol and fresh credential without copying the old ticket', () => {
+  const previous = canonicalRemoteWsUrl('wss://trainer.example/api/ws?ticket=old', status)
+  const next = new URL(freshRemoteCanonicalWsUrl('wss://trainer.example/api/ws?ticket=new', previous))
+  expect(next.searchParams.get('ticket')).toBe('new')
+  expect(next.searchParams.get('hermes_canonical')).toBe('1')
+  expect(next.toString()).not.toContain('old')
+  expect(() => freshRemoteCanonicalWsUrl('wss://another.example/api/ws?ticket=new', previous)).toThrow()
+})
+test('connection test negotiates the same canonical URL for static and OAuth auth', async () => {
+  const token = await resolveTestWsUrl('https://trainer.example', 'token', 'fixture', { status })
+  const oauth = await resolveTestWsUrl('https://trainer.example', 'oauth', null, { status, mintTicket: async () => 'fresh' })
+  expect(canonicalGatewayWsUrl(token!)).toBe(true)
+  expect(canonicalGatewayWsUrl(oauth!)).toBe(true)
+  expect(new URL(oauth!).searchParams.get('ticket')).toBe('fresh')
+})
+
+
+test('registry OAuth actual dial preserves canonical protocol and fresh exact profile-scoped headers', async () => {
+  const headers = { 'X-Synthetic-Access': 'fixture' }
+  const saved = canonicalRemoteWsUrl('wss://trainer.example/api/ws?ticket=old', status)
+  const store = createRemoteWsHeaderStore()
+  const handler = createRegistryGatewayWsUrlHandler({
+    ensureBackend: async (connectionId: unknown, profile: unknown) => {
+      expect(connectionId).toBe('personal'); expect(profile).toBe('scisense-trainer')
+      return { authMode: 'oauth', baseUrl: 'https://trainer.example', wsUrl: saved,
+        profile: 'scisense-trainer', sharedRemote: true, headers }
+    },
+    mintTicket: async () => 'fresh',
+    buildTicketUrl: baseUrl => `${baseUrl.replace(/^https:/, 'wss:')}/api/ws?ticket=fresh`,
+    rememberHeaders: store.remember
+  })
+  const url = await handler({ connectionId: 'personal', profile: 'scisense-trainer' })
+  const parsed = new URL(url)
+  expect(canonicalGatewayWsUrl(url)).toBe(true)
+  expect(parsed.searchParams.get('ticket')).toBe('fresh')
+  expect(parsed.searchParams.get('profile')).toBe('scisense-trainer')
+  expect(store.headersFor(url)).toEqual(headers)
+  parsed.searchParams.set('profile', 'another')
+  expect(store.headersFor(parsed.toString())).toEqual({})
+})
