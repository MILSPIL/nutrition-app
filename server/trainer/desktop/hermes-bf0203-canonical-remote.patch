+// Only a negotiated transport marker. Credentials still use the existing
+// remote gateway auth; local private tickets never become remote URL tokens.
+export const CANONICAL_REMOTE_QUERY = 'hermes_canonical'
+export const SCISENSE_BRIDGE_PROTOCOL = 'hermes-gateway-v1'
+
+export function canonicalRemoteWsUrl(rawUrl: string, status: unknown): string {
+  const url = new URL(rawUrl)
+  url.searchParams.delete(CANONICAL_REMOTE_QUERY)
+  const bridge = (status as { scisense?: { bridge_version?: unknown; protocol?: unknown; engine_commit?: unknown } } | null)?.scisense
+
+  if (bridge === undefined) { return url.toString() }
+  if (bridge.bridge_version !== 1 || bridge.protocol !== SCISENSE_BRIDGE_PROTOCOL ||
+      typeof bridge.engine_commit !== 'string' || !/^[a-f0-9]{40}$/.test(bridge.engine_commit)) {
+    throw new Error('Несумісне підключення Hermes. Оновіть клієнт або сервер.')
+  }
+  if (!['ws:', 'wss:'].includes(url.protocol) ||
+      !(url.searchParams.has('token') || url.searchParams.has('ticket'))) {
+    throw new Error('Для Hermes потрібне авторизоване підключення.')
+  }
+  url.searchParams.set(CANONICAL_REMOTE_QUERY, '1')
+
+  return url.toString()
+}
+
+export function canonicalGatewayWsUrl(rawUrl: string): boolean {
+  const url = new URL(rawUrl)
+
+  return url.searchParams.has('native_dial') || url.searchParams.get(CANONICAL_REMOTE_QUERY) === '1'
+}
+
+export function freshRemoteCanonicalWsUrl(rawUrl: string, previousUrl: string): string {
+  const url = new URL(rawUrl)
+  const previous = new URL(previousUrl)
+
+  if (previous.searchParams.get(CANONICAL_REMOTE_QUERY) !== '1') { return rawUrl }
+  if (url.origin !== previous.origin || url.pathname !== previous.pathname) {
+    throw new Error('Підключення Hermes змінилося. Підключіться повторно.')
+  }
+  url.searchParams.set(CANONICAL_REMOTE_QUERY, '1')
+
+  return url.toString()
+}
