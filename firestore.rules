    function padTen(part) {
      let p={'source':{'kind':'legacy'}};
      return part.concat([p,p,p,p,p,p,p,p,p]);
    }
    function allTen(rows,p) {
      return rows.size()<=4?smallSourceBatch(rows,p):
        sourceTen(rows.size()==10?rows:padTen(rows),p.sources,{'kind':'user'})
        || (rows.size()==10 && !('source' in rows[9]) && !('quantity' in rows[9]) && sourceNine(rows,p.sources,{'kind':'user'}))
        || smallSourceBatch(rows,p);
    }
    function dayPath(uid,day) { return /databases/$(database)/documents/users/$(uid)/mealHistory/$(day); }
    function projectionEqual(a,b) {
      return !b.diff(a).affectedKeys().hasAny(['meals','mealsDateKey','mealRevision','legacyMeals','legacyMealsDateKey']);
    }
    function emptyProjection(p) {
      return p.get('mealsDateKey',null)==null && p.get('mealRevision',0)==0
        && p.get('legacyMeals',null)==null && p.get('legacyMealsDateKey',null)==null
        && (p.get('meals',{})=={} || p.get('meals',{})=={'1':{},'2':{},'3':{},'4':{}});
    }
    function changedProfile(a,b) {
      let old=a.get('users',{});
      let next=b.get('users',{});
      let added=next.values().removeAll(old.values());
      let removed=old.values().removeAll(next.values());
      return next.diff(old).affectedKeys().size()==1 && added.size()==1
        && (removed.size()==0 || removed.size()==1 && !projectionEqual(removed[0],added[0])) ? added[0]:null;
    }
    function freshMirror(a,b,rootBefore,rootAfter,profile,day) {
      return profile is map && rootAfter.writerVersion==3 && b.writerVersion==3
        && rootAfter.writerNonce==b.writerNonce && rootBefore.get('writerNonce','')!=b.writerNonce
        && a.get('writerNonce','')!=b.writerNonce && b.revision is int && b.revision==a.get('revision',0)+1
        && profile.mealsDateKey==day && profile.mealRevision==b.revision && profile.meals==b.meals;
    }
    function rootMirror(uid,a,b,profile) {
      let day=profile.mealsDateKey;
      let old=get(dayPath(uid,day));
      let next=getAfter(dayPath(uid,day));
      return next!=null && freshMirror(old==null?{}:old.data,next.data,a,b,profile,day)
        ? foodHalf(uid,day,old==null?{}:old.data,next.data) : false;
    }
    function rootPreferences(old,next,profile) {
      let removed=old.values().removeAll(next.values());
      return removed.size()==1?projectionEqual(removed[0],profile):removed.size()==0 && emptyProjection(profile);
    }
    function rootProfileWrite(uid,a,b,old,next,profile) {
      return profile.get('mealsDateKey',null) is string
        ? (rootMirror(uid,a,b,profile)?true:rootPreferences(old,next,profile))
        : rootPreferences(old,next,profile);
    }
    function rootV3Write(uid,a,b) {
      let old=a.get('users',{});
      let next=b.get('users',{});
      let newProfiles=next.values().removeAll(old.values());
      let changed=next.diff(old).affectedKeys();
      return changed.size()==0 || (changed.size()==1 && newProfiles.size()==1
        && rootProfileWrite(uid,a,b,old,next,newProfiles[0]));
    }
    function dayMirror(uid,day,b) {
      let old=get(userPath(uid)).data;
      let next=getAfter(userPath(uid)).data;
      let profile=changedProfile(old,next);
      // A nonempty changed projection cannot use the preference/new-empty
      // branches on the root. Its rootMirror rule proves the fresh day revision.
      return profile is map && next.writerVersion==3 && next.writerNonce==b.writerNonce
        && old.get('writerNonce','')!=b.writerNonce && profile.mealsDateKey==day;
    }
    function legacyGroupMerge(a,l,b,k) {
      return !(k in l) || b.get(k,[])==a.get(k,[]).concat(l[k]);
    }
    function legacyMealMerge(a,l,b) {
      let keys=l.keys();
      let k=keys.size()==1?keys[0]:'';
      return l.size()==0?a==b:b.diff(a).affectedKeys().hasOnly(keys)
        && (keys.size()==1?legacyGroupMerge(a,l,b,k):
          keys.hasOnly(['voice','а','б','в','г','д','е','є','ж','з','и','і','ї','й'])
          && legacyGroupMerge(a,l,b,'voice')
          && legacyGroupMerge(a,l,b,'а')
          && legacyGroupMerge(a,l,b,'б')
          && legacyGroupMerge(a,l,b,'в')
          && legacyGroupMerge(a,l,b,'г')
          && legacyGroupMerge(a,l,b,'д')
          && legacyGroupMerge(a,l,b,'е')
          && legacyGroupMerge(a,l,b,'є')
          && legacyGroupMerge(a,l,b,'ж')
          && legacyGroupMerge(a,l,b,'з')
          && legacyGroupMerge(a,l,b,'и')
          && legacyGroupMerge(a,l,b,'і')
          && legacyGroupMerge(a,l,b,'ї')
          && legacyGroupMerge(a,l,b,'й')
        );
    }
    function emptyMeals(m) {
      return m.keys().hasOnly(['1','2','3','4']) && (m.values().hasOnly([{}])
        || m.get('1',{}).values().hasOnly([[]]) && m.get('2',{}).values().hasOnly([[]])
        && m.get('3',{}).values().hasOnly([[]]) && m.get('4',{}).values().hasOnly([[]]));
    }
    function legacyMealsMatch(a,l,b) {
      return b==l && (a==l || emptyMeals(a)) || (b.keys().hasOnly(['1','2','3','4'])
        && legacyMealMerge(a.get('1',{}),l.get('1',{}),b.get('1',{}))
        && legacyMealMerge(a.get('2',{}),l.get('2',{}),b.get('2',{}))
        && legacyMealMerge(a.get('3',{}),l.get('3',{}),b.get('3',{}))
        && legacyMealMerge(a.get('4',{}),l.get('4',{}),b.get('4',{})));
    }
    function confirmedLegacyWrite(uid,day,old,next) {
      let id=next.legacyImportProfileId;
      let before=get(userPath(uid)).data.get('users',{}).get(id,{});
      let afterRoot=getAfter(userPath(uid)).data;
      let after=afterRoot.get('users',{}).get(id,{});
      let legacy=before.get('legacyMeals',null)!=null?before.legacyMeals
        :before.get('mealsDateKey',null)==null?before.get('meals',{}):{};
      return id is string && id.size()>0 && id.size()<=128 && legacy is map
        && after.get('legacyMeals','absent')==null && after.get('legacyMealsDateKey','')==day
        && after.get('mealsDateKey','')==day && after.get('meals',{})==next.get('meals',{})
        && afterRoot.writerNonce==next.writerNonce
        && legacyMealsMatch(old.get('meals',{}),legacy,next.get('meals',{}));
    }
    function regularFoodHalf(a,b) {
      let p=sourcePolicy();
      let rows=changedFoodRows(a,b,p.groups);
      return rows.size()==0 || rows.size()<=20
        && (rows.size()>=9?(sourceNine(rows,p.sources,{'kind':'user'}) || smallSourceBatch(rows[0:9],p)):allTen(rows,p));
    }
    function foodHalf(uid,day,a,b) {
      return b.get('legacyImportProfileId','')!=a.get('legacyImportProfileId','')
        ? confirmedLegacyWrite(uid,day,a,b) : regularFoodHalf(a,b);
    }
    function regularDayFoodWrite(uid,day,a,b) {
      let p=sourcePolicy();
      let rows=changedFoodRows(a,b,p.groups);
      return rows.size()==0 || (rows.size()<=10?allTen(rows,p):
        dayMirror(uid,day,b) ? rows.size()<=20 && (rows.size()==20?
          ('source' in rows[19]?
            (sourceEleven(rows,p.sources,{'kind':'user'},rows[9].source) || allTen(rows[9:19],p) && changedFoodSource(rows[19],p))
            : allTen(rows[9:19],p) && changedFoodSource(rows[19],p))
          :allTen(rows[9:rows.size()],p)) : false);
    }
    function dayFoodWrite(uid,day,a,b) {
      return b.get('legacyImportProfileId','')!=a.get('legacyImportProfileId','')
        ? dayMirror(uid,day,b) && confirmedLegacyWrite(uid,day,a,b)
        : regularDayFoodWrite(uid,day,a,b);
    }
    function submissionFences(a,b) {
      let oldReject=a.get('rejectedSubmissions',{});
      let reject=b.get('rejectedSubmissions',{});
      let oldSuccess=a.get('submissionMarkers',{});
      let success=b.get('submissionMarkers',{});
      return ((reject==oldReject && success==oldSuccess) || (reject.diff(oldReject).unchangedKeys().size()==oldReject.size()
          && success.diff(oldSuccess).unchangedKeys().size()==oldSuccess.size()))
        && !reject.keys().hasAny(success.keys());
    }
    function historyWrite(uid,day,a,b,creating) {
      return writerValid(b,uid) ? (creating || b.writerNonce != a.get('writerNonce',''))
        && submissionFences(a,b) && (b.writerVersion == 2 || dayFoodWrite(uid,day,a,b)) : false;
    }
    function regularRootUpdate(uid,a,b,changed) {
      return changed.hasOnly(regularFields())
        && writerValid(b,uid) && b.writerNonce!=a.get('writerNonce','')
        ? (b.writerVersion==2 || rootV3Write(uid,a,b)) : false;
    }
    function rootUpdateRoute(uid,a,b) {
      let changed=b.diff(a).affectedKeys();
      return changed.hasOnly(['trainerId','trainerEmail'])
        ? (legacyClear(uid)||linkAccept(uid)||linkDisconnect(uid))
        : owner(uid) && regularRootUpdate(uid,a,b,changed);
    }
    match /users/{uid} {
      allow get, list: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(regularFields().concat(['trainerId','trainerEmail']))
        && request.resource.data.get('trainerId', null) == null
        && request.resource.data.get('trainerEmail', null) == null && writerValid(request.resource.data, uid)
        && (request.resource.data.writerVersion==2 || rootV3Write(uid,{},request.resource.data));
      allow update: if rootUpdateRoute(uid,resource.data,request.resource.data);
      allow delete: if false;
      match /mealHistory/{day} {
        allow read: if owner(uid) || assigned(uid);
        allow create, update: if owner(uid) && (resource == null
          ? historyWrite(uid,day,{},request.resource.data,true)
          : historyWrite(uid,day,resource.data,request.resource.data,false));
      }
      match /foodNotes/{noteId} {
        allow read: if owner(uid) || assigned(uid);
        allow create: if owner(uid) && notesEnabled(uid) && request.resource.data.writerVersion == 3
          && writerValid(request.resource.data,uid) && validNote(request.resource.data,noteId) && noteMarker(uid,request.resource.data)
          && noteId in getAfter(/databases/$(database)/documents/users/$(uid)/mealHistory/$(request.resource.data.targetDate)).data.foodNotes;
        allow update: if owner(uid) && notesEnabled(uid) && writerChanged(uid)
          && resource.data.state == 'active' && request.resource.data.state == 'resolved'
          && request.resource.data.keys().hasAll(['noteId','itemId','targetDate','state','submissionId','commandHash','resolvedAt','writerVersion','writerNonce','mealKey','group','itemIndex'])
          && request.resource.data.keys().hasOnly(['noteId','itemId','targetDate','state','submissionId','commandHash','resolvedAt','writerVersion','writerNonce','mealKey','group','itemIndex'])
          && request.resource.data.noteId == noteId && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.targetDate == resource.data.targetDate && text(request.resource.data.resolvedAt,80)
          && noteMarker(uid,request.resource.data) && resolvedItem(uid,request.resource.data)
          && !(noteId in getAfter(/databases/$(database)/documents/users/$(uid)/mealHistory/$(resource.data.targetDate)).data.foodNotes);
        allow delete: if false;
      }
      match /measurements/{measurement} {
        allow read: if owner(uid) || assigned(uid);
        allow create: if owner(uid) && writerValid(request.resource.data, uid);
        allow update: if owner(uid) && writerChanged(uid);
      }
    }
    match /trainers/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.get('clients', {}) is map;
      allow update: if (owner(uid) && request.resource.data.get('clients', {}) is map) || clientRemoval(uid);
      function clientRemoval(trainerId) {
        let clientId = request.auth.uid;
        let a = get(proofPath(clientId)).data;
        let b = getAfter(proofPath(clientId)).data;
        return disconnectTransition(clientId, a, b) && a.trainerId == trainerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clients'])
          && request.resource.data.clients.diff(resource.data.get('clients', {})).affectedKeys().hasOnly([clientId])
          && disconnectTogether(clientId, a);
      }
    }
    match /trainerRequests/{uid} {
      allow get: if owner(uid) || party();
      allow list: if party();
      function party() {
        return request.auth != null && (resource.data.clientId == request.auth.uid ||
          (resource.data.status == 'pending' && addressed(resource.data)) ||
          (resource.data.status in ['accepted','disconnected'] && resource.data.trainerId == request.auth.uid));
      }
      allow create: if newPending(uid, request.resource.data)
        && request.resource.data.generation == 1 && request.resource.data.revision == 1;
      allow update: if resource.data.status == 'pending' ? (accept() || finishPending())
        : (resource.data.status == 'accepted' ? disconnect() : renewal());
      function renewal() {
        return resource.data.status in ['rejected','cancelled','disconnected'] && valid(resource.data, uid)
          && resource.data.generation < 2147483647 && next(resource.data, request.resource.data)
          && request.resource.data.generation == resource.data.generation + 1
          && newPending(uid, request.resource.data);
      }
      function accept() {
        return acceptTransition(uid, resource.data, request.resource.data) && valid(resource.data, uid)
          && acceptedFields(request.resource.data) && acceptTogether(uid, request.resource.data);
      }
      function finishPending() {
        let a = resource.data;
        let b = request.resource.data;
        return a.status == 'pending' && b.status in ['cancelled','rejected'] && valid(a, uid) && next(a, b)
          && b.endedAt == request.time && b.diff(a).affectedKeys().hasOnly(['status','revision','endedAt'])
          && ((b.status == 'cancelled' && owner(uid)) || (b.status == 'rejected' && addressed(a)));
      }
      function disconnect() {
        return disconnectTransition(uid, resource.data, request.resource.data)
          && valid(resource.data, uid) && disconnectTogether(uid, resource.data);
      }
      allow delete: if !exists(userPath(uid)) && uid != resource.data.clientId && resource.data.status == 'pending'
        && (owner(resource.data.clientId) || addressed(resource.data));
    }
  }
}
