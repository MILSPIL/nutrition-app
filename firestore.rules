    function capabilityPath(uid) { return /databases/$(database)/documents/releaseCapabilities/$(uid); }
    function minimumWriter(uid) { let c=get(capabilityPath(uid)); return c == null ? 2 : c.data.get('minimumWriterVersion',2); }
    function notesEnabled(uid) { return exists(capabilityPath(uid)) && get(capabilityPath(uid)).data.get('notesEnabled', false) == true && minimumWriter(uid) == 3; }
    function writerValid(d, uid) {
