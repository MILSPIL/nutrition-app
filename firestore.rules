        && s.get('label','') is string && s.get('label','').size() <= 400
        && s.get('recordId','') is string && s.get('recordId','').size() <= 400
        && s.get('dataset','') is string && s.get('dataset','').size() <= 400
        && (s.get('version','') is string || s.get('version',0) is int)
        && s.get('url','') is string && s.get('url','').size() <= 400
        && s.get('assumptions',[]) is list && s.get('assumptions',[]).size() <= 9
        && (!('portionOrigin' in s) || portionOrigin(s.portionOrigin))
        && (!('estimateReason' in s) || s.kind == 'estimate' && s.estimateReason in ['no_matching_source','recipe_estimate']);
    }
    function noteMarker(uid, n) {
      let day = getAfter(/databases/$(database)/documents/users/$(uid)/mealHistory/$(n.targetDate)).data;
      return n.submissionId.matches('^[a-zA-Z0-9-]{8,80}$') && n.commandHash.matches('^[a-f0-9]{64}$')
        && day.writerVersion == 3 && day.writerNonce == n.writerNonce && day.submissionMarkers[n.submissionId] == n.commandHash
        && (!exists(/databases/$(database)/documents/users/$(uid)/mealHistory/$(n.targetDate)) || (
          get(/databases/$(database)/documents/users/$(uid)/mealHistory/$(n.targetDate)).data.get('writerNonce','') != day.writerNonce
          && !(n.submissionId in get(/databases/$(database)/documents/users/$(uid)/mealHistory/$(n.targetDate)).data.get('submissionMarkers',{}))));
    }
    function resolvedItem(uid,n) {
      let path = /databases/$(database)/documents/users/$(uid)/mealHistory/$(n.targetDate);
      let rows = getAfter(path).data.meals[n.mealKey][n.group];
      let oldRows = get(path).data.get('meals',{}).get(n.mealKey,{}).get(n.group,[]);
