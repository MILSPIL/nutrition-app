      let entry = getAfter(trainerPath(b.trainerId)).data.clients[uid];
      return exists(userPath(uid)) && get(userPath(uid)).data.get('trainerId', null) == null
        && exists(trainerPath(b.trainerId))
        && profile.trainerId == b.trainerId && profile.trainerEmail == b.trainerEmail
        && entry.keys().hasOnly(['name','email','addedAt','status','generation'])
        && entry.name == b.clientName && entry.email == b.clientEmail
        && entry.addedAt == request.time && entry.status == 'active' && entry.generation == b.generation;
    }
    function disconnectTransition(uid, a, b) {
      return owner(uid) && a.status == 'accepted' && b.status == 'disconnected' && next(a, b)
        && b.endedAt == request.time && b.diff(a).affectedKeys().hasOnly(['status','revision','endedAt']);
    }
    function disconnectTogether(uid, a) {
