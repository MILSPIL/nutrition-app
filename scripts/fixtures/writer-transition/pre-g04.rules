rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? lower(request.auth.token.email)
        : null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isAssignedTrainer(userId) {
      return signedIn() &&
        userDoc(userId).data.trainerId == request.auth.uid;
    }

    function isClientOfTrainer(trainerId) {
      return signedIn() &&
        userDoc(request.auth.uid).data.trainerId == trainerId;
    }

    function trainerEmailMatches(email) {
      return authEmail() != null && lower(email) == authEmail();
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isAssignedTrainer(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /mealHistory/{dayId} {
        allow read: if isOwner(userId) || isAssignedTrainer(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /measurements/{measurementId} {
        allow read: if isOwner(userId) || isAssignedTrainer(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }
    }

    match /trainers/{trainerId} {
      allow create: if signedIn() && request.auth.uid == trainerId;
      allow read: if signedIn() &&
        (request.auth.uid == trainerId || isClientOfTrainer(trainerId));
      allow update: if signedIn() && request.auth.uid == trainerId;
      allow delete: if false;
    }

    match /trainerRequests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.clientEmail == request.auth.token.email &&
        request.resource.data.status == 'pending';

      allow read: if signedIn() &&
        (resource.data.clientId == request.auth.uid ||
         trainerEmailMatches(resource.data.trainerEmail));

      allow update, delete: if signedIn() &&
        (resource.data.clientId == request.auth.uid ||
         trainerEmailMatches(resource.data.trainerEmail));
    }
  }
}
