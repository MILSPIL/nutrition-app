{
  "name": "nutrition-app",
  "version": "1.6.0",
  "private": true,
  "engines": {
    "node": "24.11.x",
    "npm": "11.x"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "REACT_APP_VERSION=$npm_package_version react-scripts start",
    "build": "REACT_APP_VERSION=$npm_package_version GENERATE_SOURCEMAP=false react-scripts build",
    "test": "REACT_APP_VERSION=$npm_package_version react-scripts test",
    "test:ci": "CI=true npm test -- --watchAll=false",
    "eject": "react-scripts eject",
    "test:voice-photo": "npm run test:ci -- --runInBand && npm --prefix workers/meal-parser test && npm run test:meal-store",
    "test:meal-store": "node scripts/meal-store-test.mjs",
    "test:voice-photo-ui": "/Users/user/.local/bin/agent-test-browser run scisense-voice-photo",
    "lab:phone:prepare": "node scripts/phone-lab.mjs prepare",
    "lab:phone": "node scripts/phone-lab.mjs start",
    "test:phone-lab": "node --test scripts/phone-lab/gateway.test.mjs",
    "test:phone-lab-ui": "/Users/user/.local/bin/agent-test-browser run scisense-phone-lab"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
