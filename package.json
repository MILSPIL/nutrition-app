{
  "name": "nutrition-app",
  "version": "1.9.2",
  "private": true,
  "engines": {
    "node": "24.22.x",
    "npm": "11.x"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.1",
    "react-scripts": "5.0.1",
    "ws": "8.22.0"
  },
  "scripts": {
    "start": "REACT_APP_VERSION=$npm_package_version react-scripts start",
    "build": "REACT_APP_VERSION=$npm_package_version GENERATE_SOURCEMAP=false react-scripts build",
    "test": "REACT_APP_VERSION=$npm_package_version react-scripts test",
    "test:ci": "CI=true npm test -- --watchAll=false",
    "eject": "react-scripts eject",
    "test:voice-photo": "npm run test:ci -- --runInBand && npm --prefix workers/meal-parser test && npm run test:meal-store",
    "test:meal-store": "node scripts/meal-store-test.mjs",
    "test:voice-photo-ui": "node scripts/browser-test.mjs voice-photo",
    "lab:phone:prepare": "node scripts/phone-lab.mjs prepare",
    "lab:phone": "node scripts/phone-lab.mjs start",
    "test:phone-lab": "node --test scripts/phone-lab/*.test.mjs",
    "test:phone-lab-ui": "node scripts/browser-test.mjs phone-lab",
    "test:server": "node --test server/*.test.mjs server/trainer/*.test.mjs",
    "test:rules": "node scripts/trainer-access-test.mjs",
    "test:trainer-ui": "node scripts/browser-test.mjs trainer-access",
    "test:hermes": "node scripts/trainer-chat-test.mjs",
    "test:hermes-ui": "node scripts/browser-test.mjs hermes-chat",
    "test:hermes-native": "node scripts/hermes-gateway-test.mjs",
    "test:hermes-store": "node scripts/hermes-store-test.mjs",
    "build:hermes-off": "node scripts/hermes-build-off.mjs",
    "test:coach-ui": "node scripts/browser-test.mjs coach-ui"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "playwright": "1.64.0",
    "tailwindcss": "3.4.19"
  }
}
