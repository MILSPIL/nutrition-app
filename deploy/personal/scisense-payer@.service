[Unit]
Description=SciSense isolated payer owner
CollectMode=inactive-or-failed
[Service]
Type=notify
NotifyAccess=main
WatchdogSec=2s
WatchdogSignal=SIGKILL
TimeoutStartSec=5s
TimeoutStopSec=1s
TimeoutAbortSec=1s
User=scisense-payer
Group=scisense-payer
SupplementaryGroups=scisense
Slice=scisense.slice
ExecStart=/usr/bin/python3 /opt/scisense/personal/adapters/hermes_service_guardian.py --config /etc/scisense/personal/payer.json
UMask=0077
RuntimeDirectory=scisense-payer
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
ReadWritePaths=/run/scisense-payer
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=false
ReadOnlyPaths=/sys
BindReadOnlyPaths=/sys
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
KillMode=control-group
Restart=no
StandardInput=socket
StandardOutput=inherit
StandardError=null
