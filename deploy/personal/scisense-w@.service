[Unit]
Description=SciSense isolated w owner
CollectMode=inactive-or-failed
[Service]
Type=notify
NotifyAccess=main
WatchdogSec=2s
WatchdogSignal=SIGKILL
TimeoutStartSec=5s
TimeoutStopSec=1s
TimeoutAbortSec=1s
User=scisense-w
Group=scisense-w
SupplementaryGroups=scisense
Slice=scisense.slice
ExecStart=/usr/bin/python3 /opt/scisense/personal/adapters/hermes_service_guardian.py --config /etc/scisense/personal/w.json
UMask=0077
RuntimeDirectory=scisense-native-w
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
ReadWritePaths=/run/scisense-native-w
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=false
ReadOnlyPaths=/sys
BindReadOnlyPaths=/sys
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
KillMode=control-group
Restart=no
StandardInput=socket
StandardOutput=inherit
StandardError=null
StateDirectory=scisense-personal-w
StateDirectoryMode=0700
ReadWritePaths=/var/lib/scisense-personal-w
