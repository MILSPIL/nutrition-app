[Unit]
Description=SciSense meal API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scisense
Group=scisense
WorkingDirectory=/opt/scisense/current
ExecStart=/opt/scisense/node/bin/node /opt/scisense/current/server/main.mjs
# Credentials are installed only with the separately approved live drop-in.
Environment=NODE_ENV=production
UMask=0077
StateDirectory=scisense
StateDirectoryMode=0700
RuntimeDirectory=scisense
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/scisense /run/scisense
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
CPUQuota=200%
MemoryMax=2G
MemorySwapMax=0
TasksMax=128
TimeoutStopSec=70s
KillMode=control-group
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
